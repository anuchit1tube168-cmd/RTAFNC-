{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtafnc-campus-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "ENVIRONMENT": "staging",
    "PRODUCTION_WRITE": "false",
    "EXPOSE_SOURCE_STATUS": "true",
    "ALLOWED_ORIGIN": "https://anuchit1tube168-cmd.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rtafnc-campus-core-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}

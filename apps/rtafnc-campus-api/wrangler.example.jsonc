{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtafnc-campus-core-read-uat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    "ENVIRONMENT": "uat",
    "PRODUCTION_WRITE": "false",
    "EXPOSE_SOURCE_STATUS": "false",
    "ALLOWED_ORIGIN": "https://anuchit1tube168-cmd.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rtafnc-campus-uat",
      "database_id": "REPLACE_WITH_EXISTING_UAT_D1_DATABASE_ID"
    }
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtafnc-vital-signs-lab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "observability": { "enabled": true }
}
